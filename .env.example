# Copy to .env.local and fill in. Never commit .env.local (it's gitignored).
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Only put values
# here that are safe to publish -- the Supabase anon/publishable key is safe
# ONLY because Row Level Security is enabled on every table (see SECURITY.md).

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co (local dev: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Public by design; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role/secret key. SERVER-ONLY. Bypasses RLS entirely.
# Never prefix this with NEXT_PUBLIC_. Never import it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, server/tooling only (migrations, seed
# script, the RLS test). Local dev default shown in README.md.
SUPABASE_DB_URL=

# Absolute site origin (no trailing slash), used to build the successUrl/
# cancelUrl handed to the payment provider. Required in production; falls
# back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# Random string (16+ chars), checked against the Authorization header
# Vercel sends when it invokes /api/cron/release-reservations. Generate
# with e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Shared secret for lib/payments/mock-adapter.ts's webhook signature
# scheme. Only used while MockPaymentAdapter is the active adapter (no
# merchant account yet) -- once a real provider is wired in, this is
# replaced by whatever signing secret that provider issues, and this
# variable goes away. Generate with e.g. `openssl rand -hex 32`.
PAYMENT_MOCK_WEBHOOK_SECRET=

# Resend API key (resend.com) and the verified "from" address to send
# order confirmation emails from, e.g. "Crude Harmony <orders@yourdomain.com>".
# If either is unset, order confirmation emails are skipped with a
# console warning rather than failing checkout/fulfilment -- see
# lib/email/send-order-confirmation.ts. Safe to leave blank for local dev.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Upstash Redis (upstash.com), used for rate limiting checkout-session
# creation, order lookup, and the payment webhook by IP. If either is
# unset, rate limiting is disabled with a console warning rather than
# failing those endpoints -- see lib/rate-limit.ts. This IS a real gap if
# it ships to production unconfigured; safe to leave blank for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (dash.cloudflare.com/?to=/:account/turnstile),
# used on the order lookup form. NEXT_PUBLIC_TURNSTILE_SITE_KEY is public
# by design (it identifies the widget, not a secret). For local dev,
# Cloudflare publishes real, live test key pairs that don't need a
# Cloudflare account -- see https://developers.cloudflare.com/turnstile/troubleshooting/testing/:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   (always passes)
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  (always passes)
# Use real keys from your own Turnstile widget in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
